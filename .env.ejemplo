# =====================================================================
#  Portal de descargas — variables de entorno (copiar a .env)
#  .env NUNCA va a git.
# =====================================================================

# --- Base propia del portal ---
DB_NAME=portal_flxia
# Dueño de la base (solo para crearla; el backend no lo usa)
DB_USER=portal_admin
DB_PASSWORD=cambiar-por-una-clave-larga
# Rol de mínimo privilegio con el que se conecta el backend
APP_DB_USER=portal_app
APP_DB_PASSWORD=cambiar-por-otra-clave-larga
# Puerto de la base en el host (solo 127.0.0.1)
DB_PORT=5465

# --- Web ---
# Dónde escucha el nginx del frontend. En producción 127.0.0.1 (el nginx del
# host pone el HTTPS delante).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3035
# Dirección pública (va en el correo de la contraseña temporal)
PORTAL_PUBLIC_URL=https://www.portal.flxia.net
# true en producción (cookie solo por https); false en local (http)
PORTAL_COOKIE_SECURE=true
PORTAL_SUPPORT_PHONE=096 060 8410

# --- Correo (contraseñas temporales) ---
PORTAL_MAIL_HOST=smtp.gmail.com
PORTAL_MAIL_PORT=587
PORTAL_MAIL_USERNAME=fluxoiaec@gmail.com
# Contraseña de aplicación de Gmail (16 letras, sin espacios).
# Se genera en https://myaccount.google.com/apppasswords con la cuenta de arriba.
PORTAL_MAIL_PASSWORD=
PORTAL_MAIL_FROM_NAME=Portal de Descargas FluxoIA
